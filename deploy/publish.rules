# Ordered rsync publication rules; keep runtime sources and license/source links.
- .*
- node_modules/
- *.env
- *.ini
- *.conf
- *.log
- *.sql
- *.sqlite
- *.sqlite3
- *.db
- *.bak
- *.old
- *.orig
- *.swp
- *~
- *.pem
- *.key
- *.p12
- *.pfx
- *.sh
- *.cjs
- *.php
- *.py
+ /index.html
+ /assets/***
+ /games/***
- *
